# Neon Postgres (pooled connection string)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Vercel Cron: protects /api/cron/celebrations (daily birthday & anniversary SMS)
CRON_SECRET=

# Comma-separated emails that can manage platform integrations (Settings → Integrations).
# SMS, payment and AI providers and their keys are entered there and stored encrypted in the database.
PLATFORM_ADMIN_EMAILS=

SUPPORT_EMAIL=             # "Contact Support" on the Enterprise plan
